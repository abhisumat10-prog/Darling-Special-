GEMINI_API_KEY=your_gemini_api_key
# Optional server-only fallback used if Gemini is unavailable or rate-limited.
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-20b

# Safe to expose in the browser. Find these under Supabase Connect / API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only. Never prefix this with VITE_ or expose it to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Comma-separated frontend origins allowed to call the local grading server.
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
